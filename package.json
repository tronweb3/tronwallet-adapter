{
    "name": "tronwallet-adapter",
    "description": "wallet adapters for TRON blockchain",
    "version": "1.3.4",
    "main": "index.js",
    "sideEffects": false,
    "private": true,
    "engines": {
        "node": "24.22.1",
        "pnpm": "11.21.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tronweb3/tronwallet-adapter"
    },
    "author": "tronweb3",
    "license": "MIT",
    "files": [
        "./packages/*/*/lib/esm/**",
        "./packages/*/*/lib/cjs/**/*.js",
        "./packages/*/*/lib/types/**",
        "./packages/*/*/src/**",
        "./packages/*/*/LICENSE",
        "./packages/*/*/README.md",
        "./packages/*/*/package.json"
    ],
    "packageManager": "pnpm@11.21.0",
    "scripts": {
        "nuke": "shx rm -rf packages/*/*/node_modules demos/**/node_modules node_modules || true",
        "reinstall": "pnpm run nuke && pnpm install",
        "clean": "pnpm --recursive run clean && shx rm -rf **/*.tsbuildinfo",
        "ts": "pnpm run build:ts",
        "build": "pnpm run build:ts && pnpm run build:other && pnpm run package && pnpm run build:umd",
        "build:ts": "tsc --build tsconfig.all.json",
        "build:other": "pnpm --recursive --filter \"@tronweb3/*\" run build",
        "build:umd": "pnpm --recursive run build:umd",
        "build-demos": "pnpm --parallel --workspace-concurrency=1 --filter \"./demos/**\" run build",
        "package": "pnpm --recursive run package",
        "release": "pnpm prerelease && changeset publish",
        "watch": "pnpm run watch:ts & pnpm run watch:other",
        "watch:ts": "tsc --build --watch tsconfig.all.json",
        "watch:other": "pnpm run --filter {packages/vue/vue-ui} watch",
        "dev": "pnpm watch & pnpm run --filter {demos/dev-demo} dev",
        "fmt": "prettier --write '{*,**/*}.{ts,tsx,js,jsx,json}'",
        "lint": "eslint .",
        "lint:fix": "pnpm run fmt && eslint --fix .",
        "test": "pnpm --recursive --filter \"@tronweb3/*\" run test && pnpm --recursive --filter @tronweb3/tronwallet-adapter-react-ui run test:unit",
        "test:coverage": "vitest run --coverage",
        "example": "pnpm run --filter {demos/react-ui/vite-app} dev",
        "prepare": "husky install && chmod ug+x .husky/*",
        "update-version": "pnpm changeset add && pnpm changeset version",
        "prerelease": "node ./scripts/check-dep-version.js",
        "e2e:update": "node scripts/sync-e2e.js"
    },
    "devDependencies": {
        "@changesets/cli": "3.0.3",
        "@commitlint/cli": "20.2.0",
        "@commitlint/config-conventional": "17.8.1",
        "@eslint/js": "^10.0.1",
        "@rollup/plugin-commonjs": "28.0.6",
        "@rollup/plugin-json": "6.1.0",
        "@rollup/plugin-node-resolve": "15.2.3",
        "@rollup/plugin-terser": "0.4.4",
        "@testing-library/jest-dom": "5.17.0",
        "@testing-library/react": "16.3.2",
        "@types/node": "22.9.0",
        "@types/scheduler": "0.16.8",
        "@types/testing-library__jest-dom": "5.14.9",
        "@typescript-eslint/eslint-plugin": "8.57.0",
        "@typescript-eslint/parser": "8.57.0",
        "@vitest/coverage-v8": "4.1.12",
        "eslint": "9.39.4",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.5",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.0.1",
        "eslint-plugin-require-extensions": "0.1.3",
        "eslint-plugin-vue": "10.8.0",
        "globals": "17.4.0",
        "husky": "8.0.3",
        "lint-staged": "17.6.0",
        "prettier": "2.7.1",
        "rollup": "4.59.0",
        "rollup-plugin-polyfill-node": "0.13.0",
        "shx": "0.3.4",
        "typescript": "5.8.2",
        "typescript-eslint": "8.57.0",
        "vue-eslint-parser": "10.4.0"
    },
    "overrides": {
        "@ledgerhq/devices": "6.27.1",
        "@ledgerhq/hw-transport": "6.27.1",
        "@ledgerhq/hw-transport-webhid": "6.27.1",
        "qs": "^6.14.1",
        "tinypool": "^2.2.0",
        "undici": "^7.29.1",
        "sharp": "^0.35.5",
        "js-yaml@<4.0.0": "3.15.2",
        "js-yaml@>=4.0.0 <5.0.0": "^4.3.2",
        "fast-uri": "^3.1.8",
        "brace-expansion": "^5.0.12",
        "axios": "^1.20.0",
        "source-map-js": "^1.2.2"
    },
    "resolutions": {
        "@ledgerhq/devices": "6.27.1",
        "@ledgerhq/hw-transport": "6.27.1",
        "@ledgerhq/hw-transport-webhid": "6.27.1",
        "qs": "^6.14.1",
        "tinypool": "^2.2.0",
        "undici": "^7.29.1",
        "sharp": "^0.35.5",
        "js-yaml@<4.0.0": "3.15.2",
        "js-yaml@>=4.0.0 <5.0.0": "^4.3.2",
        "fast-uri": "^3.1.8",
        "brace-expansion": "^5.0.12",
        "axios": "^1.20.0",
        "source-map-js": "^1.2.2"
    },
    "lint-staged": {
        "{*,**/*}.{ts,tsx,js,jsx,json}": "prettier --check",
        "{packages,.}/**/*.{ts,tsx,js,jsx,json}": "eslint"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    }
}
